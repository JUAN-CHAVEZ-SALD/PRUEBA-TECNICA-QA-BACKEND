{
  "200": {
    "type": "object",
    "properties": {
      "nome": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "format": "email",
        "pattern": "^[\\w\\.-]+@[\\w\\.-]+\\.[A-Za-z]{2,}$"
      },
      "password": {
        "type": "string",
        "minLength": 3
      },
      "administrador": {
        "type": "string",
        "enum": ["true", "false"]
      },
      "_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "required": ["nome", "email", "password", "administrador", "_id"],
    "additionalProperties": false
  }
}
